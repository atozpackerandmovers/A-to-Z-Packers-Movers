{
  "headers": [
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0",
        "Pragma": "no-cache",
        "Expires": "0"
      },
      "glob": "/"
    },
    {
      "headers": {
        "Pragma": "no-cache",
        "Expires": "0",
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "glob": "/index.html"
    },
    {
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "glob": "/app.v9.0.0.js"
    },
    {
      "glob": "/app.v9.0.1-transport.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "glob": "/styles.v9.0.0.css"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "glob": "/app.js"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "glob": "/styles.css"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "glob": "/sw.js"
    },
    {
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "glob": "/service-worker.js"
    },
    {
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://www.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app; frame-src https://www.openstreetmap.org https://az-packers-quotation-default-rtdb.asia-southeast1.firebasedatabase.app; img-src 'self' data: https://staticmap.openstreetmap.de; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "glob": "**"
    }
  ],
  "rewrites": [
    {
      "glob": "**",
      "path": "/index.html"
    }
  ]
}
