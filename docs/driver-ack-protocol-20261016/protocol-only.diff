diff --git a/integrations/driver-android-ack/app/src/main/java/com/atozpackersmovers/drivertrackerv5/firebase/ServerCommandReader.kt b/integrations/driver-android-ack/app/src/main/java/com/atozpackersmovers/drivertrackerv5/firebase/ServerCommandReader.kt
